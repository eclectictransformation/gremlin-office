      "steps": [
        {
          "text": "Warm the oil in your biggest pot and soften the onions, about 8 minutes.",
          "stove": {
            "electric": "Around 6, then turn it down sooner than you think. Electric holds heat.",
            "gas": "Medium flame."
          }
        },
        {
          "text": "Add the garlic and thyme for a minute until it smells good."
        },
        {
          "text": "Add the broth and beans and bring it up to a boil.",
          "stove": {
            "electric": "High, and walk away for a while.",
            "gas": "High."
          }
        },
        {
          "text": "Drop to a simmer and add the kale. Simmer about 45 minutes.",
          "stove": {
            "electric": "About 3. Check it after 10 minutes.",
            "gas": "Low-medium."
          }
        },
        {
          "text": "Add the pasta for the last 10 minutes if you're using it. Taste and season."
